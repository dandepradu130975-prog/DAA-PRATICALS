      "source": [
        "#selection sort\n",
        "a = list(map(int, input(\"Enter numbers: \").split()))\n",
        "\n",
        "n = len(a)\n",
        "\n",
        "for i in range(n):\n",
        "    min = i\n",
        "\n",
        "    for j in range(i + 1, n):\n",
        "        if a[j] < a[min]:\n",
        "            min = j\n",
        "\n",
        "    a[i], a[min] = a[min], a[i]\n",
        "\n",
        "print(\"Sorted array:\", a)"
      ],
      "metadata": {
