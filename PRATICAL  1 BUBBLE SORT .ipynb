      "source": [
        "#bubble sort\n",
        "a = list(map(int, input(\"Enter numbers: 1,2,3,4\").split()))\n",
        "\n",
        "n = len(a)\n",
        "\n",
        "for i in range(n):\n",
        "    for j in range(0, n - i - 1):\n",
        "\n",
        "        if a[j] > a[j + 1]:\n",
        "            a[j], a[j + 1] = a[j + 1], a[j]\n",
        "\n",
        "print(\"Sorted array:\", a)"
      ]
    }
  ]
}