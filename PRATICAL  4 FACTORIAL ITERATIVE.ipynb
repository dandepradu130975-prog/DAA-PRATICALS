      "source": [
        "fact= int(input(\"enter a number for factorial\"))\n",
        "factorial=1\n",
        "for i in range(1,fact+1):\n",
        "    factorial=factorial*i\n",
        "print(\"factorial of\",fact,\"is\",factorial)\n"
      ],
